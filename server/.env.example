# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/credlink

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Email OTP (Gmail SMTP via Nodemailer)
# Leave SMTP_USER / SMTP_PASS empty to run in Development OTP Mode (OTP printed to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# NLP (optional - rule based parser works without these)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# WhatsApp / SMS (optional - falls back to WhatsApp Web share link when empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
